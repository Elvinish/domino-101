{
  "name": "@domino/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:production": "node dist/db/migrate.js"
  },
  "dependencies": {
    "@domino/game-engine": "workspace:*",
    "@domino/protocol": "workspace:*",
    "dotenv": "17.4.2",
    "drizzle-orm": "^0.45.3",
    "fastify": "5.12.5",
    "pg": "^8.23.1",
    "socket.io": "4.8.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@domino/bot-player": "workspace:*",
    "@types/pg": "8.23.1",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15"
  }
}
