# Server: loaded from repository root by the server entry point.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:5173
# Web: Vite reads VITE_ variables from this root file. Never put secrets in VITE_.
VITE_API_BASE_URL=http://localhost:3001
# Voice defaults to Google's public STUN server. Set [] for host-only local tests.
# This JSON is embedded in the public web build; browser TURN credentials are public.
# Use scoped, short-lived TURN credentials in production; never use an admin secret.
# VITE_WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478?transport=udp","username":"scoped-user","credential":"short-lived-credential"}]
# Phase 8 persistence. Use memory for ephemeral tests or local UI work;
# production requires postgres and a secret kept outside source control.
PERSISTENCE_MODE=memory
# For optional local Docker Compose, set your own password in the ignored .env.
# POSTGRES_PASSWORD=replace-with-your-own-local-password
# URL-encode special characters in the database password.
# DATABASE_URL=postgresql://domino:change-me@127.0.0.1:5432/domino101
# Integration tests require a separate disposable database ending in _test.
# TEST_DATABASE_URL=postgresql://domino:change-me@127.0.0.1:5432/domino101_test
